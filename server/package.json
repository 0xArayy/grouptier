{
  "name": "grouptier-server",
  "version": "1.0.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && mkdir -p dist/bot/assets && cp src/bot/assets/*.png dist/bot/assets/",
    "start": "node dist/index.js",
    "db:init": "node --input-type=module < scripts/init-db.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "fastify": "^4.28.1",
    "grammy": "^1.30.0",
    "pg": "^8.13.1",
    "piscina": "^5.1.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
